# Copy to .env and fill in. Do not commit .env.

# Auth: admins (ADMIN_EMAILS) sign in with email + password; everyone else via
# OAuth. There is no API key. Provider keys are per-user (set in the app's
# Settings → Keys), never here.

# Comma-separated; admins also control the VPN.
ADMIN_EMAILS=you@gmail.com
# Non-admins allowed in (admins always are).
# ALLOWED_EMAILS=friend@x.com
# true = anyone who authenticates gets in.
# OPEN_SIGNUP=false

# Signs login cookies.
SESSION_SECRET=change_me_long_random
# Mixed into password hashes. Set once, never change.
PASSWORD_PEPPER=change_me_long_random
# Encrypts stored provider keys. Set once, never change.
KEYS_SECRET=change_me_long_random
# Only to serve auth over plain HTTP on a LAN.
# COOKIE_SECURE=false

# Local dev only — NEVER set in production. One-click "Dev sign-in" as a
# throwaway admin account, no password/OAuth. While it's on, provider keys you
# add in Settings are stored UNENCRYPTED (no KEYS_SECRET needed in dev).
# DEV_LOGIN=true
# DEV_EMAIL=dev@local

# OAuth (optional): a provider turns on when its id+secret are both set.
# Redirect URI to register: <PUBLIC_BASE_URL>/api/auth/callback/<provider>
# PUBLIC_BASE_URL=https://your-host.synology.me
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# X_OAUTH_CLIENT_ID=
# X_OAUTH_CLIENT_SECRET=

# Model that names new chats; unset = the chat's own.
# CHAT_TITLE_MODEL=

# VPN (Gluetun)
VPN_SERVICE_PROVIDER=your_vpn_provider
VPN_TYPE=wireguard
WIREGUARD_PRIVATE_KEY=your_wireguard_key_here
WIREGUARD_ADDRESSES=10.x.x.x/16
SERVER_COUNTRIES=your_country
# HTTP_CONTROL_SERVER_AUTH_DEFAULT_ROLE is derived from this.
GLUETUN_API_KEY=your_gluetun_api_key_here
TZ=UTC

# Docker / Synology
APP_PORT=8080
# Used for the HTTPS redirect (synology-boot.sh).
APP_HOSTNAME=your-hostname.local
# novpn (default) or vpn.
COMPOSE_PROFILES=novpn
# Data path inside the container.
POLLO_DATA_DIR=/data
# Host path mounted to it.
POLLO_HOST_DATA_DIR=/path/to/data
PUID=1000
PGID=1000
